{
    "name": "popcicle2003/artist-ninja",
    "description": "Photography client workflow integration for self-hosted Invoice Ninja.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ArtistNinja\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ArtistNinja\\ArtistNinjaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
